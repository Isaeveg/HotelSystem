<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="380.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;" 
      stylesheets="@css/global.css, @css/client.css" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.FilterController">

    <Label text="Filtry wyszukiwania" textFill="#003580">
        <font><Font name="Segoe UI Bold" size="20.0" /></font>
    </Label>

    <VBox spacing="10.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-weight: bold;" text="Max cena (PLN):" />
            <TextField fx:id="priceInput" prefWidth="80.0" />
        </HBox>
        <Slider fx:id="priceSlider" max="2000.0" showTickLabels="true" showTickMarks="true" />
    </VBox>

    <VBox spacing="10.0">
        <Label style="-fx-font-weight: bold;" text="Udogodnienia:" />
        <HBox spacing="20.0">
            <VBox spacing="10.0">
                <CheckBox fx:id="cbBreakfast" text="Śniadanie" />
                <CheckBox fx:id="cbParking" text="Parking" />
                <CheckBox fx:id="cbPool" text="Basen" />
            </VBox>
            <VBox spacing="10.0">
                <CheckBox fx:id="cbWifi" text="Wi-Fi" />
                <CheckBox fx:id="cbGood" text="Ocena 8+" />
                <CheckBox fx:id="cbExcellent" text="Ocena 9+" />
            </VBox>
        </HBox>
    </VBox>

    <HBox alignment="CENTER" spacing="15.0">
        <Button maxWidth="Infinity" onAction="#onClearFilters" styleClass="btn-nav-action" text="Wyczyść" HBox.hgrow="ALWAYS" />
        <Button fx:id="applyBtn" maxWidth="Infinity" onAction="#onApplyFilters" styleClass="btn-nav-action" text="Zastosuj" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>