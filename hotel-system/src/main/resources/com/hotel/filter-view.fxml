<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox prefWidth="380.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;"
      stylesheets="@css/global.css, @css/client.css" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.FilterController">

    <Label text="Filtry wyszukiwania" textFill="#003580">
        <font><Font name="Segoe UI Bold" size="20.0" /></font>
    </Label>

    <VBox spacing="8.0" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;">
        <Label style="-fx-font-weight: bold;" text="Max cena za noc (PLN):" />
        <TextField fx:id="priceInput" promptText="np. 500" />
        <Slider fx:id="priceSlider" max="2000.0" showTickLabels="true" showTickMarks="true" />
    </VBox>

    <VBox spacing="8.0" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;">
        <Label style="-fx-font-weight: bold;" text="Udogodnienia и ocena:" />
        <GridPane hgap="20.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            </columnConstraints>
            <children>
                <CheckBox fx:id="cbBreakfast" text="Śniadanie" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <CheckBox fx:id="cbParking" text="Parking" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <CheckBox fx:id="cbPool" text="Basen" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <CheckBox fx:id="cbWifi" text="Wi-Fi" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <CheckBox fx:id="cbGood" text="Ocena 8+" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <CheckBox fx:id="cbExcellent" text="Ocena 9+" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
    </VBox>

    <HBox alignment="CENTER" spacing="15.0">
        <Button maxWidth="Infinity" onAction="#onClearFilters" styleClass="btn-nav-action" text="Wyczyść" HBox.hgrow="ALWAYS" />
        <Button fx:id="applyBtn" maxWidth="Infinity" onAction="#onApplyFilters" styleClass="btn-nav-action" text="Zastosuj" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>