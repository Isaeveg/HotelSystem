<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="450.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 25;"
      stylesheets="@css/global.css, @css/client.css" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.FilterController">

    <Label text="Filtry wyszukiwania" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #003580;"/>

    <VBox spacing="10.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #fafafa; -fx-background-radius: 5;">
        <GridPane hgap="10" vgap="10">
            <Label text="Max cena (PLN):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="priceInput" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Suwak ceny:" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
            <Slider fx:id="priceSlider" max="2000.0" showTickLabels="true" showTickMarks="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <VBox spacing="10.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #fafafa; -fx-background-radius: 5;">
        <Label text="Wybierz udogodnienia:" style="-fx-font-weight: bold;"/>
        <GridPane hgap="20" vgap="10">
            <VBox spacing="8" GridPane.columnIndex="0">
                <CheckBox fx:id="cbBreakfast" text="Śniadanie" />
                <CheckBox fx:id="cbParking" text="Parking Podziemny" />
                <CheckBox fx:id="cbSpa" text="Dostęp do SPA" />
            </VBox>
            <VBox spacing="8" GridPane.columnIndex="1">
                <CheckBox fx:id="cbLateCheckOut" text="Późne wymeldowanie" />
                <CheckBox fx:id="cbCrib" text="Łóżeczko dziecięce" />
            </VBox>
        </GridPane>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Anuluj" onAction="#onClearFilters" style="-fx-background-color: #ccc; -fx-pref-width: 100;"/>
        <Button fx:id="applyBtn" text="Zastosuj" onAction="#onApplyFilters" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-pref-width: 100;"/>
    </HBox>
</VBox>