<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.AdminAddBookingController" style="-fx-padding: 20;">
    
    <Label text="Szczegóły rezerwacji" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Klient:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="clientCombo" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Pokój:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="roomCombo" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Usługi dodatkowe:" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
        <ScrollPane prefHeight="120" fitToWidth="true" style="-fx-background-color: transparent;" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <content>
                <VBox fx:id="amenitiesContainer" spacing="5"/>
            </content>
        </ScrollPane>

        <Label text="Data zameldowania:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="checkInDate" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Data wymeldowania:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="checkOutDate" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="statusCombo" prefWidth="250" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Cena całkowita (zł):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Anuluj" onAction="#onCancel" style="-fx-background-color: #ccc;"/>
        <Button text="Zapisz" onAction="#onSave" style="-fx-background-color: #0021da; -fx-text-fill: white;"/>
    </HBox>
</VBox>