<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.BookingController" style="-fx-padding: 20; -fx-background-color: white;">
    
    <Label text="Booking Details" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="150" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Room:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="roomInfoLabel" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Price per night:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="priceInfoLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Check-in Date:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateFrom" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Check-out Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateTo" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Amenities:" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
        <VBox fx:id="amenitiesContainer" spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <!-- Dynamic content -->
        </VBox>

        <Label text="Total to pay:" style="-fx-font-weight: bold;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Label fx:id="totalPriceLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003580;" text="0.00 PLN" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#onCancel" style="-fx-background-color: #ccc; -fx-pref-width: 100;"/>
        <Button fx:id="confirmBtn" text="Confirm" onAction="#onConfirm" style="-fx-background-color: #0004ff; -fx-text-fill: white; -fx-pref-width: 120;"/>
    </HBox>
</VBox>