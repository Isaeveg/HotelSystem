<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="480.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 25;"
      stylesheets="@css/global.css, @css/client.css" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.BookingController">

    <Label text="Szczegóły rezerwacji" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #003580;"/>

    <VBox spacing="10.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #fafafa; -fx-background-radius: 5;">
        <GridPane hgap="10" vgap="12">
            <Label text="Pokój:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
            <Label fx:id="roomInfoLabel" text="Nazwa pokoju" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Data zameldowania:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dateFrom" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Data wymeldowania:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dateTo" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Udogodnienia:" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
            <VBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="1">
                <CheckBox fx:id="cbBreakfast" text="Śniadanie (+40 zł/d)" />
                <CheckBox fx:id="cbParking" text="Parking Podziemny (+25 zł/d)" />
                <CheckBox fx:id="cbSpa" text="Dostęp do SPA (+100 zł)" />
                <CheckBox fx:id="cbLateCheckOut" text="Późne wymeldowanie (+50 zł)" />
                <CheckBox fx:id="cbCrib" text="Łóżeczko dziecięce (+0 zł)" />
            </VBox>

            <Label text="Telefon:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="phoneField" promptText="np. 123456789" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f1f8ff; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #d0e3ff; -fx-border-radius: 5;">
        <Label text="Do zapłaty:" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="totalPriceLabel" text="0.00 PLN" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #003580;"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Anuluj" onAction="#onCancel" style="-fx-background-color: #ccc; -fx-pref-width: 100;"/>
        <Button fx:id="confirmBtn" text="Zapisz" onAction="#onConfirmBooking" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-pref-width: 120;"/>
    </HBox>
</VBox>