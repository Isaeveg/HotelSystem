<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="client-root" 
            stylesheets="@css/global.css, @css/client.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.hotel.ClientController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-blue">
                <Label text="BookingApp" textFill="WHITE">
                    <font><Font name="Segoe UI Bold" size="20.0" /></font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#onOpenProfile" styleClass="btn-profile" text="👤 Mój Profil" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-yellow">
                <TextField fx:id="searchCityField" prefHeight="42.0" prefWidth="200.0" promptText="Dokąd jedziesz?" />
                
                <DatePicker fx:id="searchDateFrom" prefHeight="42.0" prefWidth="150.0" promptText="Data od" />
                <DatePicker fx:id="searchDateTo" prefHeight="42.0" prefWidth="150.0" promptText="Data do" />
                
                <Button onAction="#onSearchRooms" styleClass="btn-nav-action" text="Szukaj" />
                <Button onAction="#onResetSearch" styleClass="btn-nav-action" text="Wyczyść" />
                
                <Button onAction="#onOpenFilters" styleClass="btn-nav-action" text="Filtry" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#onLogoutClick" styleClass="btn-nav-action" text="Wyloguj się" />
            </HBox>

            <HBox alignment="CENTER" spacing="40.0" styleClass="client-toolbar">
                <Button fx:id="btnMain" onAction="#showMainTab" styleClass="toolbar-btn, toolbar-btn-active" text="Główna Strona" />
                <Button fx:id="btnFavs" onAction="#showFavsTab" styleClass="toolbar-btn" text="Ulubione" />
                <Button fx:id="btnMyRes" onAction="#showMyResTab" styleClass="toolbar-btn" text="Moje Rezerwacje" />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fx:id="listView" fitToWidth="true" style="-fx-background-color: transparent;">
                <content>
                    <VBox alignment="TOP_CENTER" style="-fx-padding: 30 0;">
                        <VBox alignment="TOP_LEFT" maxWidth="1050.0" spacing="20.0">
                            <Label fx:id="sectionTitle" text="Dostępne obiekty:" textFill="#333333">
                                <font><Font name="Segoe UI Bold" size="22.0" /></font>
                            </Label>
                            <FlowPane fx:id="hotelsContainer" hgap="20.0" vgap="20.0" />
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>

            <ScrollPane fx:id="detailsView" fitToWidth="true" style="-fx-background-color: -color-bg;" visible="false">
                <content>
                    <VBox alignment="TOP_CENTER" style="-fx-padding: 30 0;">
                        <VBox alignment="TOP_LEFT" maxWidth="1050.0" spacing="20.0">
                            <Button onAction="#onBackToList" styleClass="btn-back-minimal" text="← Wróć do listy" />
                            <HBox spacing="30.0" style="-fx-padding: 30;" styleClass="hotel-card">
                                <VBox fx:id="detailImageBox" alignment="CENTER" prefHeight="250.0" prefWidth="400.0" style="-fx-background-color: #eee; -fx-background-radius: 4;">
                                    <Label text="Icon" textFill="#999" />
                                </VBox>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <Label fx:id="detailTitle" text="Hotel Name" textFill="#003580" wrapText="true">
                                        <font><Font name="Segoe UI Bold" size="28.0" /></font>
                                    </Label>
                                    <Label fx:id="detailPrice" text="350 zł" textFill="#333">
                                        <font><Font name="Segoe UI Bold" size="24.0" /></font>
                                    </Label>
                                    <Label style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="Wybierz pokój:" />
                                    <VBox fx:id="detailRoomsContainer" spacing="10.0" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>