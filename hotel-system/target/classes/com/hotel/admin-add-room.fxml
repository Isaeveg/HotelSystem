<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.AdminAddRoomController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Edycja / Dodawanie Pokoju">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      
      <VBox spacing="5.0">
         <children>
            <Label text="Hotel:" />
            <ComboBox fx:id="hotelCombo" prefWidth="300.0" promptText="Select hotel..." />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Room Number:" />
            <TextField fx:id="roomNumberField" promptText="e.g. 101" />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Type:" />
            <ComboBox fx:id="roomTypeCombo" prefWidth="300.0" promptText="Standard / Suite..." />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Price per night (PLN):" />
            <TextField fx:id="roomPriceField" promptText="e.g. 250.00" />
         </children>
      </VBox>

      <VBox spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Description (optional):" />
            <TextArea fx:id="descriptionField" prefHeight="100.0" prefWidth="300.0" promptText="Sea view, quiet area etc." wrapText="true" />
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#onCancel" text="Cancel" />
            <Button fx:id="saveBtn" defaultButton="true" onAction="#onSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Save" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>