<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.AdminAddRoomController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Edycja / Dodawanie Pokoju">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      
      <VBox spacing="5.0">
         <children>
            <Label text="Hotel:" />
            <ComboBox fx:id="hotelCombo" prefWidth="300.0" promptText="Wybierz hotel..." />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Numer pokoju:" />
            <TextField fx:id="roomNumberField" promptText="np. 101" />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Typ:" />
            <ComboBox fx:id="roomTypeCombo" prefWidth="300.0" promptText="Standard / Suite..." />
         </children>
      </VBox>

      <VBox spacing="5.0">
         <children>
            <Label text="Cena za noc (PLN):" />
            <TextField fx:id="roomPriceField" promptText="np. 250.00" />
         </children>
      </VBox>

      <VBox spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Opis (opcjonalnie):" />
            <TextArea fx:id="descriptionField" prefHeight="100.0" prefWidth="300.0" promptText="Widok na morze, cicha okolica itp." wrapText="true" />
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#onCancel" text="Anuluj" />
            <Button fx:id="saveBtn" defaultButton="true" onAction="#onSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Zapisz" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>